  "dependencies": {
    "@google-cloud/functions-framework": "5.0.5",
    "@google-cloud/tasks": "^6.2.1",
    "@google/genai": "2.21.0",
    "firebase-admin": "14.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.17.57",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
